datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            Int       @id @default(autoincrement())

  logoLogicalRef Int?

  stockCode     String?   @unique

  logoName      String?
  storeName     String?
  logoDescription2 String?
  logoDescription3 String?
  producerCode  String?
  logoCategoryRaw String?
  logoSubCategoryRaw String?
  logoBrandRef  Int?
  logoUnitSetRef Int?
  logoBrandName String?
  logoUnitName String?
  logoIsActive  Boolean  @default(true)
  lastLogoModifiedAt DateTime?
  lastLogoSyncAt DateTime?

  name          String
  slug          String    @unique

  shortDescription String?
  description   String?

  price         Float?
  vatRate       Float?

  brand         String?

  category      String?
  subCategory   String?
  googleTaxonomyId String?
  googleTaxonomyPath String?

  unit          String?

  stockStatus   String?

  imageUrl      String?

  features      String?
  catalogVerificationNote String?

  showOnWebsite Boolean @default(false)
  isFeatured    Boolean @default(false)
  webStockStatus String?
  sortOrder     Int     @default(0)

  suggestedName String?
  suggestedShortDescription String?
  suggestedDescription String?
  suggestedCategory String?
  suggestedSubCategory String?
  suggestedBrand String?
  suggestedFeatures String?
  suggestedGoogleTaxonomyId String?
  suggestedGoogleTaxonomyPath String?
  suggestedSourceUrls String?
  suggestedLearningNotes String?
  suggestionVerificationStatus String?
  suggestionWarnings String?
  suggestionConfidence Float?
  suggestionSource String?
  suggestionStatus String @default("none")
  suggestionGeneratedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LogoBrandReference {
  id          Int      @id @default(autoincrement())
  logicalRef  Int      @unique
  code        String?
  name        String
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model LogoUnitReference {
  id          Int      @id @default(autoincrement())
  unitSetRef  Int      @unique
  setCode     String?
  setName     String?
  mainUnitCode String?
  mainUnitName String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  name      String
  role      String    @default("agent")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  payments  Payment[]
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
}

model Payment {
  id             Int       @id @default(autoincrement())

  customerName   String

  companyName    String?

  description    String?

  amount         Float

  status         String

  transactionId  String?

  cardMasked     String?

  providerName String?

  orderId String?

  errorCode      String?

  errorMessage   String?

  agentId        Int?
  agent          User?     @relation(fields: [agentId], references: [id])

  createdAt      DateTime @default(now())
}

model PaymentProvider {
  id          Int      @id @default(autoincrement())

  name        String

  apiUser     String?
  apiPassword String?

  merchantId  String?
  storeKey    String?
  gatewayUrl  String?

  isActive    Boolean @default(false)

  createdAt   DateTime @default(now())
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())

  actorId    Int?
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id])

  action     String
  entityType String
  entityId   Int?
  entityName String?
  details    String?
  ipAddress  String?

  createdAt  DateTime @default(now())
}
